# ============================================================================
# Letter IRL - Development Environment Configuration
# ============================================================================
# Copy this file to .env.dev and fill in the values
# Run with: npm run dev:env
# ============================================================================

# Server Configuration
LETTER_IRL_HTTP_HOST=0.0.0.0
LETTER_IRL_HTTP_PORT=8788
LETTER_IRL_PUBLIC_BASE_URL=https://your-railway-dev-url.up.railway.app

# MCP Endpoint Configuration
LETTER_IRL_MCP_PATH=/mcp
LETTER_IRL_SSE_PATH=/mcp
LETTER_IRL_SSE_MESSAGES_PATH=/messages

# CORS Configuration (add your Railway dev URL)
LETTER_IRL_ALLOWED_ORIGINS=https://chat.openai.com,https://chatgpt.com,https://your-railway-dev-url.up.railway.app
LETTER_IRL_ALLOWED_HOSTS=your-railway-dev-url.up.railway.app,localhost,127.0.0.1

# ============================================================================
# Auth0 - DEVELOPMENT TENANT (separate from production)
# ============================================================================
# Create a new Auth0 tenant for development: letter-irl-dev
# Configure the same connections: Google, Microsoft, Apple, GitHub, Username-Password
# Import the DEV ChatGPT CIMD URL as a public Auth0 application. Do not share
# this application with Claude/PAT clients or configure a client secret.

LETTER_IRL_DEPLOYMENT_ENVIRONMENT=development
LETTER_IRL_OAUTH_ISSUER=https://letter-irl-dev.us.auth0.com/
LETTER_IRL_OAUTH_DEV_ISSUER=https://letter-irl-dev.us.auth0.com/
LETTER_IRL_OAUTH_AUTH_ENDPOINT=https://letter-irl-dev.us.auth0.com/authorize
LETTER_IRL_OAUTH_TOKEN_ENDPOINT=https://letter-irl-dev.us.auth0.com/oauth/token
LETTER_IRL_OAUTH_JWKS_URI=https://letter-irl-dev.us.auth0.com/.well-known/jwks.json
LETTER_IRL_MCP_RESOURCE=https://your-railway-dev-url.up.railway.app/mcp
LETTER_IRL_OAUTH_AUDIENCE=https://your-railway-dev-url.up.railway.app/mcp
LETTER_IRL_OAUTH_ALLOWED_ALGORITHMS=RS256
LETTER_IRL_OAUTH_SCOPES=openid,profile,email,mail:read,mail:draft,mail:send

# Temporary DEV rollback only; leave disabled for the target CIMD path.
LETTER_IRL_OAUTH_STATIC_DCR_COMPATIBILITY=false
CHATGPT_STATIC_CLIENT_ID=
LETTER_IRL_OAUTH_LEGACY_AUDIENCES=

# Authentication Requirement (set to false to disable auth for quick testing)
LETTER_IRL_REQUIRE_AUTH=true

# Optional debug toggle (defaults to false when unset)
# Set true in dev to enable extra widget/server diagnostics
DEBUG=true

# Default User (fallback when auth is disabled)
LETTER_IRL_DEFAULT_USER_ID=dev-user

# ============================================================================
# Neon PostgreSQL - DEVELOPMENT BRANCH
# ============================================================================
# Create a dev branch from production using Neon branching
# Use: npm run dev:sync to refresh from production

DATABASE_URL=postgresql://user:password@ep-dev-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ============================================================================
# Admin Configuration
# ============================================================================
# Enable admin routes for development
ADMIN_ENABLED=true

# For Railway deployment, allow remote admin access (careful!)
# ADMIN_LOCAL_ONLY=false

# Comma-separated list of Auth0 user IDs that have admin access
LETTER_IRL_ADMIN_USER_IDS=

# ============================================================================
# Letter Fulfillment Provider - DUMMY (no real mail)
# ============================================================================
# Use dummy provider for development - no API calls, no cost

LETTER_PROVIDER=dummy
LETTER_PROVIDER_API_KEY=
LETTER_PROVIDER_CONFIG={"delayMs":500,"failureRate":0,"costCents":100,"deliveryDays":3,"verbose":true}

# Alternative: PostGrid test mode (generates PDFs but no real mail)
# LETTER_PROVIDER=postgrid
# LETTER_PROVIDER_API_KEY=test_sk_...
# LETTER_PROVIDER_CONFIG={"mode":"test","verbose":true}

# ============================================================================
# Default Sender Address (for providers that need it)
# ============================================================================

LETTER_IRL_DEFAULT_SENDER_ADDRESS=123 Dev Street
LETTER_IRL_DEFAULT_SENDER_CITY=San Francisco
LETTER_IRL_DEFAULT_SENDER_STATE=CA
LETTER_IRL_DEFAULT_SENDER_ZIP=94102

# ============================================================================
# Stripe Payment Configuration - TEST MODE
# ============================================================================
# Use Stripe test mode keys (sk_test_...) for development
# Create test products/prices or use existing test mode products

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Test Price IDs (create via Stripe CLI or dashboard)
STRIPE_PRICE_STARTER=price_...    # Starter Pack - 4 Credits ($5)
STRIPE_PRICE_REGULAR=price_...    # Regular Pack - 10 Credits ($10)
STRIPE_PRICE_POWER=price_...      # Power Pack - 100 Credits ($90)

# ============================================================================
# Worker Configuration
# ============================================================================
# Enable workers for full functionality
DISABLE_WORKERS=false

# ============================================================================
# Development Sync Configuration (for npm run dev:sync)
# ============================================================================
# These are used by the sync script to copy data from production

# Production Auth0 tenant (for user export)
# AUTH0_PROD_DOMAIN=dev-njmdyqf8n25rqgy7.us.auth0.com
# AUTH0_PROD_CLIENT_ID=...
# AUTH0_PROD_CLIENT_SECRET=...

# Development Auth0 tenant (for user import)
# AUTH0_DEV_DOMAIN=dev-ky21dxn3qmi71hjl.us.auth0.com
# AUTH0_DEV_CLIENT_ID=...
# AUTH0_DEV_CLIENT_SECRET=...

# Neon project ID (for branch management)
# NEON_PROJECT_ID=...
# NEON_API_KEY=...
