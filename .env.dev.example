# ============================================================================
# Letter IRL - Development Environment Configuration
# ============================================================================
# Copy this file to .env.dev and fill in the values
# Run with: npm run dev:env
# ============================================================================

# Server Configuration
LETTER_IRL_HTTP_HOST=0.0.0.0
LETTER_IRL_HTTP_PORT=8788
LETTER_IRL_PUBLIC_BASE_URL=https://your-railway-dev-url.up.railway.app

# MCP Endpoint Configuration
LETTER_IRL_MCP_PATH=/mcp
LETTER_IRL_SSE_PATH=/mcp
LETTER_IRL_SSE_MESSAGES_PATH=/messages

# CORS Configuration (add your Railway dev URL)
LETTER_IRL_ALLOWED_ORIGINS=https://chat.openai.com,https://chatgpt.com,https://your-railway-dev-url.up.railway.app
LETTER_IRL_ALLOWED_HOSTS=your-railway-dev-url.up.railway.app,localhost,127.0.0.1

# ============================================================================
# Auth0 - DEVELOPMENT TENANT (separate from production)
# ============================================================================
# Create a new Auth0 tenant for development: letter-irl-dev
# Configure the same connections: Google, Microsoft, Apple, GitHub, Username-Password
# Import the DEV ChatGPT CIMD URL as a public Auth0 application. Do not share
# this application with Claude/PAT clients or configure a client secret.

LETTER_IRL_DEPLOYMENT_ENVIRONMENT=development
LETTER_IRL_OAUTH_ISSUER=https://letter-irl-dev.us.auth0.com/
LETTER_IRL_OAUTH_DEV_ISSUER=https://letter-irl-dev.us.auth0.com/
LETTER_IRL_OAUTH_AUTH_ENDPOINT=https://letter-irl-dev.us.auth0.com/authorize
LETTER_IRL_OAUTH_TOKEN_ENDPOINT=https://letter-irl-dev.us.auth0.com/oauth/token
LETTER_IRL_OAUTH_JWKS_URI=https://letter-irl-dev.us.auth0.com/.well-known/jwks.json
LETTER_IRL_MCP_RESOURCE=https://your-railway-dev-url.up.railway.app/mcp
LETTER_IRL_OAUTH_AUDIENCE=https://your-railway-dev-url.up.railway.app/mcp
LETTER_IRL_OAUTH_ALLOWED_ALGORITHMS=RS256
LETTER_IRL_OAUTH_SCOPES=openid,profile,email,mail:read,mail:draft,mail:send

# Temporary DEV rollback only; leave disabled for the target CIMD path.
LETTER_IRL_OAUTH_STATIC_DCR_COMPATIBILITY=false
CHATGPT_STATIC_CLIENT_ID=
LETTER_IRL_OAUTH_LEGACY_AUDIENCES=

# Authentication Requirement (set to false to disable auth for quick testing)
LETTER_IRL_REQUIRE_AUTH=true

# Optional debug toggle (defaults to false when unset)
# Set true in dev to enable extra widget/server diagnostics
DEBUG=true

# Default User (fallback when auth is disabled)
LETTER_IRL_DEFAULT_USER_ID=dev-user

# ============================================================================
# Neon PostgreSQL - DEVELOPMENT BRANCH
# ============================================================================
# Create a dev branch from production using Neon branching
# Use: npm run dev:sync to refresh from production

DATABASE_URL=postgresql://user:password@ep-dev-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ============================================================================
# Legacy Admin Configuration
# ============================================================================
# Public admin routes are forced off. Setting this to true fails startup.
ADMIN_ENABLED=false

# ============================================================================
# Letter Fulfillment Provider - PostGrid TEST MODE (no real mail)
# ============================================================================
# This is what the deployed development environment runs. Real provider, real
# request validation, PDFs generated, nothing posted. Keeping the example in
# step with the deployment matters: routing also consults the provider_routing
# table before falling back to this variable, so a value here that disagrees
# with the deployment sends a reader looking in the wrong place.

LETTER_PROVIDER=postgrid
LETTER_PROVIDER_API_KEY=test_sk_...
LETTER_PROVIDER_CONFIG={"mode":"test","verbose":true}

# Alternative: the dummy provider, for local work with no provider credential.
# It never contacts an API and costs nothing. failureRate simulates terminal
# rejections - useful for exercising the fulfilment-failure paths, which the
# real provider will not produce on demand.
# LETTER_PROVIDER=dummy
# LETTER_PROVIDER_API_KEY=
# LETTER_PROVIDER_CONFIG={"delayMs":500,"failureRate":0,"costCents":100,"deliveryDays":3,"verbose":true}

# ============================================================================
# Default Sender Address (for providers that need it)
# ============================================================================

LETTER_IRL_DEFAULT_SENDER_ADDRESS=123 Dev Street
LETTER_IRL_DEFAULT_SENDER_CITY=San Francisco
LETTER_IRL_DEFAULT_SENDER_STATE=CA
LETTER_IRL_DEFAULT_SENDER_ZIP=94102

# ============================================================================
# Stripe Payment Configuration - TEST MODE
# ============================================================================
# Use Stripe test mode keys (sk_test_...) for development
# Create test products/prices or use existing test mode products

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Test Price IDs (create via Stripe CLI or dashboard)
STRIPE_PRICE_STARTER=price_...    # Starter Pack - 4 Credits ($5)
STRIPE_PRICE_REGULAR=price_...    # Regular Pack - 10 Credits ($10)
STRIPE_PRICE_POWER=price_...      # Power Pack - 100 Credits ($90)

# Store currency; every Price must match its product's pinned amount in
# src/config/products.ts (#275/#278). Nothing to mirror here.
STRIPE_CURRENCY=usd

# Pay & Send stays off until migration 021 is applied and test-mode validation passes.
JIT_PURCHASE_ENABLED=false
STRIPE_JIT_LETTER_PRICE_ID=price_...
STRIPE_JIT_POSTCARD_PRICE_ID=price_...
# Pay & Send currency (defaults to STRIPE_CURRENCY when unset).
JIT_CURRENCY=usd
# Minimum 40: Stripe refuses a session expiring within 30 minutes, and a
# further 10 leaves a sessionless order reusable on retry. Lower values
# are raised to 40.
JIT_CHECKOUT_EXPIRY_MINUTES=40
JIT_REFUND_RETRY_LIMIT=5
JIT_REFUND_RETRY_DELAY_SECONDS=300
JIT_ALLOW_WITH_PREPAID_BALANCE=false
LETTER_IRL_PACKS_URL=https://your-dev-website.example/pricing
IMAGE_ENTITLEMENTS_PER_PACK_LETTER=5
IMAGE_ENTITLEMENTS_PER_JIT_ORDER=1
IMAGE_RESERVATION_PRE_DISPATCH_TIMEOUT_MINUTES=15
IMAGE_RESERVATION_PROVIDER_TIMEOUT_MINUTES=30
IMAGE_TRIAL_ENABLED=false
IMAGE_TRIAL_DAILY_BUDGET_CENTS=0

# ============================================================================
# Worker Configuration
# ============================================================================
# Enable workers for full functionality
DISABLE_WORKERS=false

# ============================================================================
# Development Sync Configuration (for npm run dev:sync)
# ============================================================================
# These are used by the sync script to copy data from production

# Production Auth0 tenant (for user export)
# AUTH0_PROD_DOMAIN=dev-njmdyqf8n25rqgy7.us.auth0.com
# AUTH0_PROD_CLIENT_ID=...
# AUTH0_PROD_CLIENT_SECRET=...

# Development Auth0 tenant (for user import)
# AUTH0_DEV_DOMAIN=dev-ky21dxn3qmi71hjl.us.auth0.com
# AUTH0_DEV_CLIENT_ID=...
# AUTH0_DEV_CLIENT_SECRET=...

# Neon project ID (for branch management)
# NEON_PROJECT_ID=...
# NEON_API_KEY=...

# ============================================================================
# LIMITED BETA - cohort gate and spend ceilings (#179)
# ============================================================================
# Access gate. ON when unset, and ON for anything unreadable: only an explicit
# false/0/no/off/disabled turns it off. A typo must not open production, which
# is why this flag and the kill switch at the bottom of this block use OPPOSITE
# helpers. The table in src/utils/envSettings.ts says which to reach for.
#
# Set false for local and test use: the stdio server authenticates as
# "mcp-user", which is on no invite list.
LETTER_IRL_BETA_GATE_ENABLED=false

# The invite list, as Auth0 subjects: auth0|abc123,google-oauth2|456
# Operators listed in LETTER_IRL_ADMIN_USER_IDS are admitted automatically, so
# switching the gate on cannot lock you out of /api/admin.
#
# A subject does not exist until that person has signed in once. Admission is
# therefore: invitee signs in -> is refused -> you read their sub from the
# Auth0 dashboard -> you add it here.
#
# EMPTY LIST + GATE ON = NOBODY GETS IN. That is the safe direction for a
# missing allowlist (an outage, not an exposure), and it is why this must be
# set in a live environment BEFORE the gate is switched on there.
LETTER_IRL_BETA_ALLOWED_SUBJECTS=

# Spend ceilings, all daily rather than cumulative - a cumulative cap bricks
# the product when it is hit and needs a redeploy to clear. 0 is a KILL SWITCH
# (refuse everything), not "unlimited", matching LETTER_IRL_IMAGE_DAILY_CEILING.
LETTER_IRL_BETA_GLOBAL_DAILY_MAIL_CEILING=25
LETTER_IRL_BETA_ACCOUNT_DAILY_MAIL_CAP=3
LETTER_IRL_BETA_ACCOUNT_DAILY_CHARGE_CENTS=6000

# The emergency stop for outbound mail, and the OPPOSITE polarity to the gate
# above: a typo here STOPS sending, because mailing a letter is irreversible.
# Prefer this to zeroing a ceiling. An unparseable ceiling silently falls back
# to its default - which is the number you were trying to escape.
LETTER_IRL_MAIL_SENDING_ENABLED=true
