# Letter IRL admin panel, local development profile.
#
# Copy to .env.admin.local (git-ignored) and run `npm run admin:dev`. Nothing
# here is a production value; the panel refuses local-dev mode on Railway.
# On Railway the same variables are set on the letter-irl-admin service
# (docs/admin-panel-guide.md), with ADMIN_TAILSCALE_MODE left unset.

LETTER_IRL_DEPLOYMENT_ENVIRONMENT=development
NODE_ENV=development
ADMIN_MODE=read-only
ADMIN_TAILSCALE_MODE=local-dev
ADMIN_LOCAL_DEV_LOGIN=you@example.com
ADMIN_OPERATOR_LOGINS=you@example.com
# Health listener (Railway injects PORT); the panel itself listens on loopback.
PORT=8080
ADMIN_APP_PORT=8790
# Both roles are created by SQL on the development branch, never in the Neon
# console; see docs/admin-panel-guide.md. Read-only mode points both at the
# reader.
ADMIN_READER_DATABASE_URL=postgres://letter_irl_admin_reader_development:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=postgres://letter_irl_admin_reader_development:PASSWORD@HOST/DATABASE?sslmode=require
# At least 32 random characters: `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
ADMIN_SESSION_SECRET=
# Base32, required only in full mode; produced by `npm run admin:totp-enrol`.
ADMIN_TOTP_SECRET=
# Optional: a test-mode restricted key for the Stripe pages (never a live key here).
STRIPE_SECRET_KEY=
LETTER_PROVIDER=dummy
