# Admin-only local environment
# Copy this to .env.admin and fill in your Neon DATABASE_URL
#
# Usage:
#   cp .env.admin.example .env.admin
#   # Edit .env.admin with your production DATABASE_URL
#   npm run admin
#   # Visit http://localhost:8788/admin

# Enable admin routes (disabled by default)
ADMIN_ENABLED=true

# Restrict to localhost only
ADMIN_LOCAL_ONLY=true

# Disable workers - don't compete with Railway for jobs
DISABLE_WORKERS=true

# Your production Neon DATABASE_URL
# Get this from: https://console.neon.tech → your project → Connection Details
DATABASE_URL=postgres://username:password@ep-xxx.region.aws.neon.tech/letterirl?sslmode=require

# Port (default 8788)
PORT=8788
