{
  "name": "letter-irl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/mcp/httpServer.js",
    "start:api": "node dist/mcp/httpServer.js",
    "maintenance": "node dist/cli/runMaintenance.js",
    "db:migrate:prod": "node dist/cli/migrate.js",
    "dev": "tsx watch src/mcp/httpServer.ts",
    "dev:env": "dotenv -e .env.dev -- tsx watch src/mcp/httpServer.ts",
    "dev:sync": "tsx scripts/dev-sync.ts",
    "lint": "eslint .",
    "manifest:generate": "tsx scripts/write-manifest.ts",
    "test:submission": "vitest run tests/unit/auth/oauthMetadata.test.ts tests/unit/mcp/manifest.test.ts tests/unit/mcp/registerTools.test.ts tests/unit/mcp/widgetResources.test.ts tests/unit/mcp/submissionReadiness.test.ts",
    "check:submission": "npm run lint && npm run test:submission",
    "check:oauth-discovery": "tsx scripts/check-oauth-discovery.ts",
    "preflight:cutover": "tsx scripts/preflight-cutover.ts",
    "flow": "tsx src/cli/flowHarness.ts",
    "mcp:stdio": "tsx src/mcp/stdioServer.ts",
    "mcp:http": "tsx src/mcp/httpServer.ts",
    "db:test": "tsx scripts/test-db.ts",
    "db:migrate": "tsx db/migrate.ts",
    "db:migrate:rollback": "tsx db/migrate.ts rollback",
    "test:postgrid": "tsx scripts/test-postgrid.ts",
    "admin:provision-access": "tsx scripts/provisionAdminDatabaseAccess.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:integration:postgres": "vitest run tests/integration",
    "test:integration:local": "tsx scripts/run-integration-local.ts",
    "verify": "npm run lint && npm run build && npm run test:unit && npm run test:submission",
    "test:coverage": "vitest run --coverage",
    "dev:local": "env $(cat .env.local | grep -v '^#' | grep -v '^$' | xargs) tsx watch src/mcp/httpServer.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1089.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "jose": "^6.1.0",
    "pg": "^8.11.3",
    "sharp": "^0.34.5",
    "stripe": "^20.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^20.11.30",
    "@types/pg": "^8.11.0",
    "@vitest/coverage-v8": "^4.0.15",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-prettier": "^5.1.3",
    "globals": "^17.4.0",
    "prettier": "^3.2.5",
    "tsx": "^4.6.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.0.15"
  }
}
