{
  "name": "letter-irl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "echo 'Skipping tsc - using tsx at runtime'",
    "start": "tsx src/mcp/httpServer.ts",
    "dev": "tsx watch src/mcp/httpServer.ts",
    "lint": "eslint .",
    "flow": "tsx src/cli/flowHarness.ts",
    "mcp:stdio": "tsx src/mcp/stdioServer.ts",
    "mcp:http": "tsx src/mcp/httpServer.ts",
    "db:test": "tsx scripts/test-db.ts",
    "db:migrate": "tsx db/migrate.ts",
    "db:migrate:rollback": "tsx db/migrate.ts rollback",
    "test:postgrid": "tsx scripts/test-postgrid.ts",
    "admin": "env $(grep -v '^#' .env.admin | xargs) tsx src/mcp/httpServer.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "@types/cookie-parser": "^1.4.10",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "jose": "^6.1.0",
    "pg": "^8.11.3",
    "pg-boss": "^10.3.3",
    "stripe": "^20.0.0",
    "tsx": "^4.6.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/pg": "^8.11.0",
    "@vitest/coverage-v8": "^4.0.15",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5",
    "vitest": "^4.0.15"
  }
}
