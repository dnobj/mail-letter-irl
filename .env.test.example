# Letter IRL Test Environment Configuration
# Copy this file to .env.test and fill in the values

# =============================================================================
# Database - Use a separate test database
# =============================================================================
DATABASE_URL=postgres://localhost:5432/letterirl_test

# =============================================================================
# Stripe Test Mode
# =============================================================================
# Get test keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_test_starter
STRIPE_PRICE_REGULAR=price_test_regular
STRIPE_PRICE_POWER=price_test_power
STRIPE_STARTER_AMOUNT_CENTS=500
STRIPE_REGULAR_AMOUNT_CENTS=1000
STRIPE_POWER_AMOUNT_CENTS=9000
STRIPE_CURRENCY=usd

JIT_PURCHASE_ENABLED=false
STRIPE_JIT_LETTER_PRICE_ID=price_test_jit_letter
STRIPE_JIT_POSTCARD_PRICE_ID=price_test_jit_postcard
JIT_LETTER_AMOUNT_CENTS=499
JIT_POSTCARD_AMOUNT_CENTS=499
JIT_CURRENCY=usd
JIT_CHECKOUT_EXPIRY_MINUTES=30
JIT_REFUND_RETRY_LIMIT=3
JIT_ALLOW_WITH_PREPAID_BALANCE=false
IMAGE_ENTITLEMENTS_PER_PACK_LETTER=5
IMAGE_ENTITLEMENTS_PER_JIT_ORDER=1
IMAGE_TRIAL_ENABLED=false
IMAGE_TRIAL_DAILY_BUDGET_CENTS=0

# =============================================================================
# PostGrid Test Mode
# =============================================================================
# Get test key from PostGrid dashboard
POSTGRID_API_KEY=test_sk_...

# =============================================================================
# Auth0 (same tenant, but for testing)
# =============================================================================
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.letterirl.com

# =============================================================================
# Test Settings
# =============================================================================
NODE_ENV=test

# Disable console.log in tests (optional)
# SUPPRESS_LOGS=true
