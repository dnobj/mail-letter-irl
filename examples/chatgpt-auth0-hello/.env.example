# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8788

# Public URL (use your ngrok domain or production domain)
PUBLIC_BASE_URL=https://amitotically-gubernacular-elise.ngrok-free.dev

# SSE Paths (usually don't need to change these)
SSE_PATH=/mcp/sse
SSE_MESSAGES_PATH=/mcp/sse/messages

# CORS Configuration
ALLOWED_ORIGINS=https://chat.openai.com,https://chatgpt.com,https://amitotically-gubernacular-elise.ngrok-free.dev
ALLOWED_HOSTS=amitotically-gubernacular-elise.ngrok-free.dev,localhost,127.0.0.1

# Auth0 Configuration
# Get these from your Auth0 Dashboard → Applications → Your App
AUTH0_ISSUER=https://dev-ky21dxn3qmi71hjl.us.auth0.com/
AUTH0_AUTHORIZATION_ENDPOINT=https://dev-ky21dxn3qmi71hjl.us.auth0.com/authorize
AUTH0_TOKEN_ENDPOINT=https://dev-ky21dxn3qmi71hjl.us.auth0.com/oauth/token
AUTH0_JWKS_URI=https://dev-ky21dxn3qmi71hjl.us.auth0.com/.well-known/jwks.json

# Optional: Dynamic Client Registration endpoint (required by ChatGPT)
# You may need to enable this in Auth0 Dashboard → Advanced Settings → Endpoints
AUTH0_REGISTRATION_ENDPOINT=https://dev-ky21dxn3qmi71hjl.us.auth0.com/oidc/register

# Auth0 API Audience (create an API in Auth0 Dashboard)
# IMPORTANT: Set this as the Default Audience in Auth0 tenant settings
# to work around ChatGPT not sending the audience parameter
AUTH0_AUDIENCE=https://letter-irl/api

# OAuth Scopes (comma-separated)
AUTH0_SCOPES=openid,email,profile
