# Server Configuration
LETTER_IRL_HTTP_HOST=0.0.0.0
LETTER_IRL_HTTP_PORT=8788
LETTER_IRL_PUBLIC_BASE_URL=https://your-ngrok-url.ngrok-free.dev

# MCP Endpoint Configuration
LETTER_IRL_MCP_PATH=/mcp
LETTER_IRL_SSE_PATH=/mcp
LETTER_IRL_SSE_MESSAGES_PATH=/messages

# CORS Configuration
LETTER_IRL_ALLOWED_ORIGINS=https://chat.openai.com,https://chatgpt.com,https://your-ngrok-url.ngrok-free.dev
LETTER_IRL_ALLOWED_HOSTS=your-ngrok-url.ngrok-free.dev,your-ngrok-url.ngrok-free.dev:443,localhost,127.0.0.1,0.0.0.0:8788

# Auth0 OAuth Configuration
# ChatGPT uses its OpenAI-hosted HTTPS CIMD URL as a public client ID with
# authorization code + PKCE S256 and token_endpoint_auth_method=none.
LETTER_IRL_DEPLOYMENT_ENVIRONMENT=development
LETTER_IRL_OAUTH_ISSUER=https://your-tenant.auth0.com/
LETTER_IRL_OAUTH_DEV_ISSUER=https://your-tenant.auth0.com/
LETTER_IRL_OAUTH_AUTH_ENDPOINT=https://your-tenant.auth0.com/authorize
LETTER_IRL_OAUTH_TOKEN_ENDPOINT=https://your-tenant.auth0.com/oauth/token
LETTER_IRL_OAUTH_JWKS_URI=https://your-tenant.auth0.com/.well-known/jwks.json
LETTER_IRL_MCP_RESOURCE=https://your-ngrok-url.ngrok-free.dev/mcp
LETTER_IRL_OAUTH_AUDIENCE=https://your-ngrok-url.ngrok-free.dev/mcp
LETTER_IRL_OAUTH_ALLOWED_ALGORITHMS=RS256
# Advertised in protected-resource metadata; ChatGPT requests exactly this set.
# offline_access is what makes Auth0 issue a refresh token - omit it and the
# connection dies at access-token expiry, recoverable only by human re-consent
# (issue #160). It requires "Allow Offline Access" on the Auth0 API.
# This override is also the safe rollout lever: switch a tenant on here first,
# verify, and only then rely on the built-in default.
LETTER_IRL_OAUTH_SCOPES=openid,profile,email,offline_access,mail:read,mail:draft,mail:send

# Temporary, environment-specific rollback only. Leave disabled for CIMD.
LETTER_IRL_OAUTH_STATIC_DCR_COMPATIBILITY=false
CHATGPT_STATIC_CLIENT_ID=
LETTER_IRL_OAUTH_LEGACY_AUDIENCES=

# Authentication Requirement
LETTER_IRL_REQUIRE_AUTH=true

# Optional debug toggle (defaults to false when unset)
# Accepts: true/false, 1/0, on/off, yes/no
DEBUG=false

# Default User (fallback when auth is disabled)
LETTER_IRL_DEFAULT_USER_ID=mcp-user

# Manifest and Assets
LETTER_IRL_MANIFEST_ROUTE=/manifest.json
LETTER_IRL_WIDGET_PATH=/widgets

# Neon PostgreSQL Database
# Get your connection string from: https://console.neon.tech/
DATABASE_URL=postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require

# Legacy public admin routes are forced off; do not set ADMIN_ENABLED=true.

# ============================================================================
# Letter Fulfillment Provider Configuration
# ============================================================================

# Provider Selection
# Options: "dummy" (testing), "postgrid" (production), "lob" (future)
LETTER_PROVIDER=dummy

# Provider API Key
# For PostGrid: Get from https://dashboard.postgrid.com/ → Settings
# For Dummy: Not required (leave blank)
LETTER_PROVIDER_API_KEY=

# ============================================================================
# Provider-Specific Configuration (JSON)
# ============================================================================

# Dummy Provider Configuration (for testing)
# LETTER_PROVIDER_CONFIG='{"delayMs":1000,"failureRate":0.05,"costCents":100,"deliveryDays":3,"verbose":true}'

# PostGrid Provider Configuration
# LETTER_PROVIDER_CONFIG='{"mode":"test","verbose":true}'
# Note: Set mode to "live" for production (costs real money!)

# ============================================================================
# Default Sender Address (for providers that need it)
# ============================================================================

LETTER_IRL_DEFAULT_SENDER_ADDRESS=123 Main St
LETTER_IRL_DEFAULT_SENDER_CITY=San Francisco
LETTER_IRL_DEFAULT_SENDER_STATE=CA
LETTER_IRL_DEFAULT_SENDER_ZIP=94102

# ============================================================================
# Stripe Payment Configuration
# ============================================================================

# Stripe API Keys
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (from Stripe Dashboard > Products)
# These are the pre-created price IDs for each credit package
# Pack and Pay & Send AMOUNTS are deliberately absent. They come from the Stripe
# Price itself, resolved once at startup (#275). Keeping a second copy here let
# the two drift: Stripe charged one figure while the ledger booked another, with
# a refund as the discovery event. Set the price in Stripe; nothing to mirror.
STRIPE_PRICE_STARTER=price_...    # Starter Pack - 4 Credits ($5)
STRIPE_PRICE_REGULAR=price_...    # Regular Pack - 10 Credits ($10)
STRIPE_PRICE_POWER=price_...      # Power Pack - 100 Credits ($90)

# Store currency; every Price must be denominated in it (JIT_CURRENCY may differ)
STRIPE_CURRENCY=usd

# Just-in-time Pay & Send (deploy disabled first, then enable by environment)
JIT_PURCHASE_ENABLED=false
STRIPE_JIT_LETTER_PRICE_ID=price_...
STRIPE_JIT_POSTCARD_PRICE_ID=price_...
# The AMOUNT is not set here. Since #275 it is pinned in src/config/products.ts
# and BOTH environments' Stripe Prices must equal that pin exactly, or the
# product refuses to price rather than selling at a guess. Point these ids at
# Prices of the pinned amount; changing a price is a source edit plus a new
# Stripe Price, in one commit.
JIT_CURRENCY=usd
# Minimum 40: Stripe refuses a session expiring within 30 minutes, and a
# further 10 leaves a sessionless order reusable on retry. Lower values
# are raised to 40.
JIT_CHECKOUT_EXPIRY_MINUTES=40
JIT_REFUND_RETRY_LIMIT=5
JIT_REFUND_RETRY_DELAY_SECONDS=300
JIT_ALLOW_WITH_PREPAID_BALANCE=false
LETTER_IRL_PACKS_URL=https://letterirl.com/pricing

# Explicit image entitlements. The unaffiliated trial remains disabled.
IMAGE_ENTITLEMENTS_PER_PACK_LETTER=5
IMAGE_ENTITLEMENTS_PER_JIT_ORDER=2

# Hybrid image generation (generate_image_for_mail; decision record Addendum 3)
# Server-side generation runs ONLY against user credits; missing key/store
# degrades gracefully to the redirect card (never boot-fails).
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1.5
# OPENAI_IMAGE_QUALITY=medium
# on | off | mobile_only - whether @Letter IRL image requests may generate
# server-side (mobile_only limits credit spend to the surface where the
# mention-scoped toolset makes it irreplaceable; desktop gets the free path)
LETTER_IRL_IMAGE_GEN_MODE=on
# One-time free allowance per user, granted lazily on first use (0 disables)
LETTER_IRL_IMAGE_STARTER_CREDITS=3
# Global generations/day across ALL users. 0 is a KILL SWITCH (blocks all).
LETTER_IRL_IMAGE_DAILY_CEILING=200
IMAGE_RESERVATION_PRE_DISPATCH_TIMEOUT_MINUTES=15
IMAGE_RESERVATION_PROVIDER_TIMEOUT_MINUTES=30
IMAGE_TRIAL_ENABLED=false
IMAGE_TRIAL_DAILY_BUDGET_CENTS=0

# ============================================================================
# LIMITED BETA - cohort gate and spend ceilings (#179)
# ============================================================================
# Access gate. ON when unset, and ON for anything unreadable: only an explicit
# false/0/no/off/disabled turns it off. A typo must not open production, which
# is why this flag and the kill switch at the bottom of this block use OPPOSITE
# helpers. The table in src/utils/envSettings.ts says which to reach for.
#
# Set false for local and test use: the stdio server authenticates as
# "mcp-user", which is on no invite list.
LETTER_IRL_BETA_GATE_ENABLED=false

# The invite list, as Auth0 subjects: auth0|abc123,google-oauth2|456
# Operators listed in LETTER_IRL_ADMIN_USER_IDS are admitted automatically, so
# switching the gate on cannot lock you out of /api/admin.
#
# A subject does not exist until that person has signed in once. Admission is
# therefore: invitee signs in -> is refused -> you read their sub from the
# Auth0 dashboard -> you add it here.
#
# EMPTY LIST + GATE ON = NOBODY GETS IN. That is the safe direction for a
# missing allowlist (an outage, not an exposure), and it is why this must be
# set in a live environment BEFORE the gate is switched on there.
LETTER_IRL_BETA_ALLOWED_SUBJECTS=

# Spend ceilings, all daily rather than cumulative - a cumulative cap bricks
# the product when it is hit and needs a redeploy to clear. 0 is a KILL SWITCH
# (refuse everything), not "unlimited", matching LETTER_IRL_IMAGE_DAILY_CEILING.
LETTER_IRL_BETA_GLOBAL_DAILY_MAIL_CEILING=25
LETTER_IRL_BETA_ACCOUNT_DAILY_MAIL_CAP=3
LETTER_IRL_BETA_ACCOUNT_DAILY_CHARGE_CENTS=6000

# The emergency stop for outbound mail, and the OPPOSITE polarity to the gate
# above: a typo here STOPS sending, because mailing a letter is irreversible.
# Prefer this to zeroing a ceiling. An unparseable ceiling silently falls back
# to its default - which is the number you were trying to escape.
LETTER_IRL_MAIL_SENDING_ENABLED=true
